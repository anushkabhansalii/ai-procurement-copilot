# Local mock service (run_local.py reads these; defaults shown)
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
VENDOR_RISK_PORT=8001
UI_PORT=8501

# Model provider. The copilot still returns the deterministic decision without a key
# (the AI summary is then marked unavailable); real evaluation numbers need a key.
LLM_PROVIDER=gemini          # gemini | anthropic | stub
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite   # evaluated model; see docs/model_selection.md
GEMINI_RPM=12                 # measured free-tier limit for this model is 15
